---

import ThemeIcon from './ThemeIcon.astro'
---

<div class="fixed top-4 inset-x-0 z-50 ">
  <div class="lg:max-w-4xl mx-auto px-8">
    <div class="w-full mx-auto">
      <div
        x-data="{ open: false }"
        class="relative flex flex-col w-full p-2 mx-auto bg-black/70 dark:bg-blue-50 border
         border-white/10 shadow-md backdrop-blur-xl backdrop-filter 
         rounded-xl md:rounded-full md:items-center md:justify-between md:flex-row md:px-6">
        <div
          class="flex flex-row items-center justify-between md:justify-start">
          <a
            class="text-white dark:text-black hover:text-white/50 items-center font-bold gap-3 inline-flex text-lg"
            href="/">
            {
              
            }
          <img src="/logos/troisiemeoeillogoWHITE.webp" width="30px" height="30px" alt="logo troisieme oeil digital" class="block dark:hidden">
          <img src="/logos/troisiemelogo.webp" width="30px" height="30px" alt="logo troisieme oeil digital" class="hidden dark:block">

        
            <span class="uppercas">Troiseme Oeil <span class="uppercase hidden md:inline-block">Digital</span> ™</span>
          </a>
          <button
            @click="open = !open"
            class="inline-flex items-center justify-center p-2 text-zinc-400 hover:text-blue-300 focus:outline-none focus:text-white md:hidden">
            <svg
              class="w-6 h-6"
              stroke="currentColor"
              fill="none"
              viewBox="0 0 24 24">
              <path
                :class="{'hidden': open, 'inline-flex': !open }"
                class="inline-flex"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16">
              </path>
              <path
                :class="{'hidden': !open, 'inline-flex': open }"
                class="hidden"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12">
              </path>
            </svg>
          </button>
        </div>
        <nav
          :class="{'flex': open, 'hidden': !open}"
          class="flex-col flex-grow hidden  md:py-0 md:flex md:items-end justify-center md:flex-row">
          <ul
            class="space-y-2 list-none md:space-y-0 md:ml-auto items-center md:inline-flex justify-center text-center md:text-left gap-3">
            <li>
              <a
                href="#projects"
                class="lg:py-10 text-xs uppercase text-white dark:text-black hover:text-blue-400">
                projects
              </a>
            </li>
            <li>
              <a
                href="#services"
                class="lg:py-10 text-xs uppercase text-white dark:text-black hover:text-blue-400">
                Services
              </a>
            </li>
            <li>
              <a
                href="#pricing"
                class="lg:py-10 text-xs uppercase text-white dark:text-black hover:text-blue-400">
                Pricing
              </a>
            </li>
           
            <li>
              <a
                href="#faq"
                class="lg:py-10 text-xs uppercase text-white dark:text-black hover:text-blue-400">
                FAQ
              </a>
            </li>
            <li>
              <a
                href="/contact"
                class="lg:py-10 text-xs uppercase text-white dark:text-black hover:text-blue-400">
                contact
              </a>
            </li>
      
            <li>
             
                
                <ThemeIcon />

            </li>
            <li>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </div>
</div>
